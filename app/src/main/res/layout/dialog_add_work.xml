<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicionar Trabalho"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etWorkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título (ex: Lista de exercícios)"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disciplina"
            android:layout_marginTop="8dp"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinnerWorkDiscipline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:layout_marginTop="12dp"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinnerWorkType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/etWorkDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Data de Entrega (opcional)"
            android:focusable="false"
            android:clickable="true" />

        <EditText
            android:id="@+id/etWorkNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Notas (opcional)"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:lines="3" />

    </LinearLayout>
</ScrollView>